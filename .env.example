# launchd/install.sh copies this to .env and fills in the folders and time zone. Write values without quotes.
# These are the host-side settings; cameras and times live in config/config.json (edit it by hand or at
# http://localhost:8080).

# Folders on this Mac that the containers write to. They must already exist. They can be the same folder.
IMAGES_PATH=
VIDEOS_PATH=

# Time zone of the cameras: decides file names, EXIF times and where one day ends.
TIMEZONE=America/New_York

# Optional: failure messages are also POSTed here as plain text (an ntfy.sh topic URL works as is).
NOTIFY_URL=

# Optional: fetched after every run that works. Give it a check address from a service that alerts when the
# visits stop (healthchecks.io: period 1 day), and a Mac that is off or logged out no longer fails silently.
HEARTBEAT_URL=

WEB_PORT=8080
